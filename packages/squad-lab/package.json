{
  "name": "@deduvafork/squad-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Run one goal across several model providers and compare the results, recorded in ADP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "lab": "npx tsx src/cli.ts",
    "grade-check": "npx tsx scripts/live-grade-check.ts",
    "stream-check": "npx tsx scripts/live-stream-check.ts"
  },
  "dependencies": {
    "@deduvafork/squad-sdk": "*",
    "fastify": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
