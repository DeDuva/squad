{
  "name": "@deduvafork/squad-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Run one goal across several model providers and compare the results, recorded in ADP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./adp": "./src/adp.ts",
    "./conformance": "./src/conformance.ts",
    "./grader": "./src/grader.ts",
    "./harness": "./src/harness.ts",
    "./harnesses/ai-sdk": "./src/harnesses/ai-sdk.ts",
    "./harnesses/native": "./src/harnesses/native.ts",
    "./isolate": "./src/isolate.ts",
    "./pricing": "./src/pricing.ts",
    "./summary": "./src/summary.ts",
    "./tools/default": "./src/tools/default.ts",
    "./tools/jail": "./src/tools/jail.ts",
    "./tools/taxonomy": "./src/tools/taxonomy.ts",
    "./variance": "./src/variance.ts",
    "./variants": "./src/variants.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p web/tsconfig.json",
    "lab": "npx tsx src/cli.ts",
    "grade-check": "npx tsx scripts/live-grade-check.ts",
    "stream-check": "npx tsx scripts/live-stream-check.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "ui-check": "npx tsx scripts/live-ui-check.ts",
    "harness-check": "npx tsx scripts/harness-check.ts",
    "pricing-check": "npx tsx scripts/pricing-check.ts",
    "study": "npx tsx scripts/study.ts",
    "variance-report": "npx tsx scripts/variance-report.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.45",
    "@ai-sdk/google": "^2.0.86",
    "@deduvafork/squad-sdk": "*",
    "@fastify/static": "^10.1.3",
    "ai": "^5.0.228",
    "fastify": "^5.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
